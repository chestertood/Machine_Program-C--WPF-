<UserControl x:Class="WpfApp1.Page2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp1"
             mc:Ignorable="d" 
             >

    <Grid Background="#383a35">
        <StackPanel>
            <StackPanel Background="#de3940" Height="66" Orientation="Horizontal">
                <!--<Image Source="Images/Icon_program.ico" Height="66" HorizontalAlignment="Left"/>-->
                <TextBlock Text="MY PROGRAM" FontSize="45" Foreground="White" Margin="10,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <WrapPanel Orientation="Vertical" Margin="0,20">
                    <TextBlock Text="Please Input Your EN" FontSize="20" Focusable="True" Foreground="White"/>
                    <TextBlock Text="Please Select Model" FontSize="20" Margin="0,8" Foreground="White"/>
                </WrapPanel>
                <WrapPanel Orientation="Vertical" Margin="20">
                    <TextBox x:Name="EN_ID" Width="400" Height="25" FontSize="20" MaxLength="12" ></TextBox>
                    <ComboBox x:Name="ProductSelector"  Margin="0,10"  Width="400" Height="25" FontSize="15" >
                        <ComboBoxItem IsSelected="True" Content="MODEL1" FontSize="20" />
                        <ComboBoxItem Content="MODEL2" FontSize="20"/>
                    </ComboBox>
                </WrapPanel>
                <WrapPanel Orientation="Vertical" Margin="0,30">
                    <Button Name="Ok_button" Content="OK" Click="OK_Click" IsDefault="True" Width="40" Height="40"></Button>
                </WrapPanel>
            </StackPanel>
            <StackPanel Background="#464d53" Height="66" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
